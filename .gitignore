# Windows
*.bat

# Build outputs
android/build/
android/.gradle/
android/.cxx/
android/assets/dotnet_bcl/
android/local.properties
android/res/values-*/godot_project_name_string.xml
android/res/values/godot_project_name_string.xml
src/patcher/bin/
src/patcher/obj/
src/STS2Mobile/bin/
src/STS2Mobile/obj/
tools/**/bin/
tools/**/obj/
tmp/
tmp-*/

# Large binary files
*.tar.gz
*.apk
*.so
*.pck
*.aar
*.aar.bak*
*.jar
# The Gradle wrapper jar is the one jar that must ship: without it a clean
# clone cannot build at all (./gradlew dies before it can download anything).
!android/gradle/wrapper/gradle-wrapper.jar
*.keystore

# Third-party sources & SDKs
vendor/

# FMOD logos (proprietary)
android/assets/FMOD_LOGOS/

# Upstream game files
upstream/

# Python venv
venv/
__pycache__/

# Logs
logs.txt

# Hidden directories
.*
!.gitignore
!.github/
!.github/**

# IDE
*.user
*.suo

# .NET
*.nupkg
patchnotes.md
artifacts/
